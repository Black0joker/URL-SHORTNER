{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=URLShortener;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "URLShortener",
    "Audience": "URLShortener.Clients",
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenExpirationMinutes": 60
  },
  "UrlShortening": {
    "BaseUrl": "https://myshort.com"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EntryTtlSeconds": 3600,
    "NegativeTtlSeconds": 30
  },
  "Analytics": {
    "StreamKey": "analytics:clicks",
    "ConsumerGroup": "workers",
    "BatchSize": 500,
    "MaxStreamLength": 100000,
    "PublishBufferCapacity": 10000,
    "FlushFailureDelayMilliseconds": 1000,
    "PollDelayMilliseconds": 500
  },
  "QrCode": {
    "PixelsPerModule": 10,
    "CacheTtlSeconds": 604800
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpenOnStoreFailure": true,
    "Policies": {
      "auth-register": { "PermitLimit": 5, "WindowSeconds": 3600, "PartitionBy": "ip" },
      "auth-login": { "PermitLimit": 10, "WindowSeconds": 60, "PartitionBy": "ip" },
      "url-create": { "PermitLimit": 100, "WindowSeconds": 60, "PartitionBy": "user" },
      "url-read": { "PermitLimit": 60, "WindowSeconds": 60, "PartitionBy": "user" },
      "redirect": { "PermitLimit": 1000, "WindowSeconds": 60, "PartitionBy": "ip" }
    }
  }
}
